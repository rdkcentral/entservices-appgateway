precondition = ["Platform"]
callsign = "org.rdk.AppActions"
autostart = "@PLUGIN_APPACTIONS_AUTOSTART@"
startuporder = "@PLUGIN_APPACTIONS_STARTUPORDER@"
configuration = JSON()

rootobject = JSON()
rootobject.add("mode", "@PLUGIN_APPACTIONS_MODE@")
rootobject.add("locator", "lib@PLUGIN_IMPLEMENTATION@.so")
configuration.add("root", rootobject)