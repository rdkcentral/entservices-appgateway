@@ -108,2 +113,29 @@ bool L2testController::StartThunder()
-    /* Allow time for the server to start. */
-    (void)sleep(1U);
+    if (0 != std::system("command -v curl >/dev/null 2>&1")) {
+        L2TEST_LOG("Thunder readiness check cannot run: curl is unavailable");
+        return false;
+    }
+
+    /* Wait for the server's JSON-RPC endpoint before attempting COM-RPC. */
+    const std::string readinessCommand =
+        "curl --silent --show-error --max-time 1 "
+        "--header 'Content-Type: application/json' "
+        "--data '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"Controller.1.status\"}' "
+        "http://" + std::string(THUNDER_ADDRESS) + ":" + THUNDER_PORT + "/jsonrpc "
+        ">/dev/null 2>&1";
+
+    bool thunderReady = false;
+    for (int attempt = 1; attempt <= THUNDER_READY_MAX_ATTEMPTS; ++attempt) {
+        L2TEST_LOG("Thunder readiness attempt #%d/%d at http://%s:%s/jsonrpc",
+                   attempt, THUNDER_READY_MAX_ATTEMPTS, THUNDER_ADDRESS, THUNDER_PORT);
+        if (0 == std::system(readinessCommand.c_str())) {
+            thunderReady = true;
+            L2TEST_LOG("Thunder JSON-RPC endpoint is ready");
+            break;
+        }
+        usleep(THUNDER_READY_DELAY_MS * 1000);
+    }
+
+    if (!thunderReady) {
+        L2TEST_LOG("Thunder did not become ready after %d attempts", THUNDER_READY_MAX_ATTEMPTS);
+        return false;
+    }
