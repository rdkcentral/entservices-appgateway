function(detect_unsafe_owned_worker_pool source_text result)
    string(REGEX REPLACE "Core::IWorkerPool::Instance\\(\\)\\.Submit\\(PluginHost::IShell::Job::Create\\([^;]+;" "" checked "${source_text}")
    string(REGEX MATCH "PostToWorkerPool[ \t\r\n]*\\([ \t\r\n]*\\[[^]]*(this|=)[^]]*\\]" unsafe_capture "${checked}")
    string(REGEX MATCH "IWorkerPool::Instance[ \t\r\n]*\\([ \t\r\n]*\\)[ \t\r\n]*\\.[ \t\r\n]*Submit" direct_submit "${checked}")
    string(REGEX MATCH "class[ \t\r\n]+[^;{]*Job[^;{]*:[^{]*IDispatch[^{]*\\{[^}]*([A-Za-z_][A-Za-z0-9_:<>]*)[ \t]*\\*[ \t]*m(Parent|Owner)" raw_owner_job "${checked}")
    if(unsafe_capture OR direct_submit OR raw_owner_job)
        set(${result} TRUE PARENT_SCOPE)
    else()
        set(${result} FALSE PARENT_SCOPE)
    endif()
endfunction()

set(owned_worker_pool_positive "PostToWorkerPool([](Owner& owner) { owner.Run(); });")
detect_unsafe_owned_worker_pool("${owned_worker_pool_positive}" positive_rejected)
if(positive_rejected)
    message(FATAL_ERROR "Owned WorkerPool enforcement rejected the approved typed callback fixture")
endif()

set(owned_worker_pool_this_negative "PostToWorkerPool([this]() { Run(); });")
detect_unsafe_owned_worker_pool("${owned_worker_pool_this_negative}" this_accepted)
if(NOT this_accepted)
    message(FATAL_ERROR "Owned WorkerPool enforcement accepted a raw-this fixture")
endif()

set(owned_worker_pool_implicit_negative "PostToWorkerPool([=]() { Run(); });")
detect_unsafe_owned_worker_pool("${owned_worker_pool_implicit_negative}" implicit_accepted)
if(NOT implicit_accepted)
    message(FATAL_ERROR "Owned WorkerPool enforcement accepted an implicit-this fixture")
endif()

set(owned_worker_pool_direct_negative "Core::IWorkerPool::Instance().Submit(job);")
detect_unsafe_owned_worker_pool("${owned_worker_pool_direct_negative}" direct_accepted)
if(NOT direct_accepted)
    message(FATAL_ERROR "Owned WorkerPool enforcement accepted a direct-submit fixture")
endif()

set(owned_worker_pool_raw_negative "class BadJob : public Core::IDispatch { Owner* mOwner; };")
detect_unsafe_owned_worker_pool("${owned_worker_pool_raw_negative}" raw_accepted)
if(NOT raw_accepted)
    message(FATAL_ERROR "Owned WorkerPool enforcement accepted a raw-owner fixture")
endif()

set(owned_worker_pool_shell_allowlisted "Core::IWorkerPool::Instance().Submit(PluginHost::IShell::Job::Create(service, state, reason));")
detect_unsafe_owned_worker_pool("${owned_worker_pool_shell_allowlisted}" shell_rejected)
if(shell_rejected)
    message(FATAL_ERROR "Owned WorkerPool enforcement rejected the shell-job allowlist fixture")
endif()

foreach(owned_worker_pool_source IN LISTS OWNED_WORKER_POOL_SOURCES)
    file(READ "${owned_worker_pool_source}" owned_worker_pool_content)
    detect_unsafe_owned_worker_pool("${owned_worker_pool_content}" owned_worker_pool_unsafe)
    if(owned_worker_pool_unsafe)
        message(FATAL_ERROR "Unsafe owner-dependent WorkerPool submission in ${owned_worker_pool_source}")
    endif()
endforeach()
